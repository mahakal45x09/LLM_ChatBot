# ==========================================
# LLM Chatbot Environment Variables
# Copy this file to .env and insert your key
# DO NOT commit .env to version control!
# ==========================================

# Active Provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# Bot Persona Name
BOT_NAME=Nova

# System Prompt (Defines bot's role, persona, and behavioral boundaries)
# SYSTEM_PROMPT=You are Nova, an expert AI Software Architect...

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Context Window Management (keep last N messages in active context)
MAX_HISTORY_MESSAGES=10

# Request Timeout (seconds)
REQUEST_TIMEOUT_SECONDS=45

# Server Configuration
HOST=0.0.0.0
PORT=8000
